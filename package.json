{
  "name": "culture-gap",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AYTO (Are You The One): tell it what you're making and where. Qloo reads what that city loves beyond the rest of the country and finds the gap; your own LLM writes the idea into it.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "probe": "node scripts/probe.mjs",
    "record": "node scripts/record-samples.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@qloo/qloo-harness": "0.1.26",
    "express": "4.22.3"
  },
  "devDependencies": {
    "three": "0.170.0"
  }
}
