{
  "name": "culture-gap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agent that reads cultural momentum country by country with Qloo and spots the fashion styles and brands that follow, before they reach each market.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "probe": "node scripts/probe.mjs",
    "record": "node scripts/record-samples.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@qloo/qloo-harness": "0.1.26",
    "express": "4.21.2"
  }
}
